<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="GEOARCON – Empresa constructora en La Paz, Bolivia. Construimos ideas, desarrollamos proyectos y transformamos espacios. Diseño 2D/3D, cómputos, obra gruesa, obra fina, instalaciones y estructuras metálicas.">
    <meta name="author" content="GEOARCON Empresa Constructora">
    <title>GEOARCON – Empresa Constructora | La Paz, Bolivia</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           VARIABLES GLOBALES – PALETA GEOARCON
           ============================================================ */
        :root {
            --primary-color:   #1A2B4C;   /* Azul Marino Profundo  */
            --accent-color:    #FF6B35;   /* Naranja Vibrante      */
            --secondary-color: #8ECAE6;   /* Azul Celeste Cristal  */
            --base-bg:         #F8F9FA;   /* Blanco Humo           */
            --border-color:    #E3E7ED;   /* Gris Claro Neutro     */

            --dark-color:      #1A2B4C;
            --light-color:     #F8F9FA;
            --text-color:      #1A2B4C;
            --muted-text:      #4A5568;

            --shadow-sm: 0 4px 14px rgba(26, 43, 76, 0.06);
            --shadow-md: 0 10px 30px rgba(26, 43, 76, 0.10);
            --shadow-lg: 0 20px 50px rgba(26, 43, 76, 0.16);

            --radius: 14px;
            --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html { scroll-behavior: smooth; scroll-padding-top: 110px; }

        body {
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            color: var(--text-color);
            background-color: var(--base-bg);
            overflow-x: hidden;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, h5, h6,
        .section-title,
        .navbar-brand,
        .counter-item h2,
        .service-card h4,
        .contact-info-box h4,
        .contact-form-box h4,
        .mission-vision h5,
        .value-card h5,
        .process-step h5,
        .feature-item h5 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            letter-spacing: -0.4px;
        }

        /* ============================================================
           TOP HEADER
           ============================================================ */
        .top-header {
            background-color: var(--primary-color);
            color: #fff;
            padding: 9px 0;
            font-size: 13.5px;
            font-family: 'Inter', sans-serif;
        }
        .top-header a {
            color: #fff;
            text-decoration: none;
            margin-right: 22px;
            transition: color var(--transition);
            white-space: nowrap;
        }
        .top-header a:hover { color: var(--accent-color); }
        .top-header i {
            margin-right: 7px;
            color: var(--accent-color);
        }
        .top-header .social-mini a {
            margin-right: 0;
            margin-left: 14px;
            font-size: 15px;
        }

        /* ============================================================
           MENÚ PRINCIPAL
           ============================================================ */
        .main-header {
            background: #fff;
            box-shadow: 0 2px 14px rgba(26, 43, 76, 0.08);
            padding: 10px 0;
            position: sticky;
            top: 0;
            z-index: 1050;
            border-bottom: 1px solid var(--border-color);
        }

        /* ============================================================
           LOGO GEOARCON – GRANDE Y VISIBLE
           ============================================================ */
        .navbar-brand {
            display: flex;
            align-items: center;
            padding: 0;
            margin-right: 20px;
        }
        .navbar-brand img,
        .navbar-brand svg {
            height: 78px;              /* Logo grande y protagonista */
            width: auto;
            max-width: 300px;
            object-fit: contain;
            transition: transform var(--transition);
            display: block;
        }
        .navbar-brand:hover img,
        .navbar-brand:hover svg {
            transform: scale(1.04);
        }

        .navbar-nav .nav-link {
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            color: var(--primary-color);
            text-transform: uppercase;
            font-size: 12.5px;
            letter-spacing: 0.9px;
            margin: 0 10px;
            position: relative;
            padding: 8px 0;
            transition: color var(--transition);
        }
        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-link.active { color: var(--accent-color); }

        .navbar-nav .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            width: 0; height: 3px;
            background: var(--accent-color);
            border-radius: 2px;
            transition: width var(--transition);
        }
        .navbar-nav .nav-link:hover::after,
        .navbar-nav .nav-link.active::after { width: 100%; }

        .navbar-toggler {
            border: 1.5px solid var(--border-color);
            padding: 6px 10px;
        }
        .navbar-toggler:focus { box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.15); }

        .btn-nav-cta {
            background: var(--accent-color);
            color: #fff !important;
            padding: 10px 22px !important;
            border-radius: 8px;
            font-size: 12px !important;
            letter-spacing: 1px;
            margin-left: 14px;
            transition: all var(--transition);
        }
        .btn-nav-cta::after { display: none !important; }
        .btn-nav-cta:hover {
            background: var(--primary-color);
            color: #fff !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(26, 43, 76, 0.25);
        }

        /* ============================================================
           HERO SLIDER
           ============================================================ */
        .hero-slider {
            position: relative;
            height: 88vh;
            min-height: 560px;
            overflow: hidden;
        }
        .slide {
            position: absolute;
            inset: 0;
            width: 100%; height: 100%;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.2s ease-in-out;
            display: flex;
            align-items: center;
        }
        .slide.active { opacity: 1; }

        .slide::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                135deg,
                rgba(26, 43, 76, 0.90) 0%,
                rgba(26, 43, 76, 0.62) 55%,
                rgba(255, 107, 53, 0.30) 100%
            );
        }

        .slide-content {
            position: relative;
            z-index: 2;
            color: #fff;
            max-width: 760px;
        }
        .slide-content .slide-tag {
            display: inline-block;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 3px;
            text-transform: uppercase;
            background: rgba(255, 107, 53, 0.18);
            border: 1px solid var(--accent-color);
            color: var(--accent-color);
            padding: 6px 16px;
            border-radius: 50px;
            margin-bottom: 22px;
        }
        .slide-content h1 {
            font-size: 3.1rem;
            font-weight: 800;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            line-height: 1.12;
        }
        .slide-content h1 span { color: var(--accent-color); }
        .slide-content p {
            font-family: 'Inter', sans-serif;
            font-size: 1.12rem;
            font-weight: 400;
            margin-bottom: 34px;
            opacity: 0.95;
            max-width: 620px;
        }

        .btn-primary-custom {
            background: var(--accent-color);
            border: 2px solid var(--accent-color);
            color: #fff;
            padding: 14px 36px;
            border-radius: 8px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13.5px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            transition: all var(--transition);
            box-shadow: 0 8px 22px rgba(255, 107, 53, 0.35);
            text-decoration: none;
            display: inline-block;
        }
        .btn-primary-custom:hover {
            background: transparent;
            color: var(--accent-color);
            box-shadow: 0 12px 28px rgba(255, 107, 53, 0.45);
            transform: translateY(-3px);
        }
        .btn-outline-custom {
            background: transparent;
            border: 2px solid rgba(255,255,255,0.7);
            color: #fff;
            padding: 14px 32px;
            border-radius: 8px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13.5px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            transition: all var(--transition);
            text-decoration: none;
            display: inline-block;
            margin-left: 10px;
        }
        .btn-outline-custom:hover {
            background: #fff;
            color: var(--primary-color);
            border-color: #fff;
            transform: translateY(-3px);
        }

        .slider-dots {
            position: absolute;
            bottom: 38px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 12px;
            z-index: 3;
        }
        .slider-dots .dot {
            width: 12px; height: 12px;
            border-radius: 50%;
            border: 2px solid #fff;
            background: transparent;
            cursor: pointer;
            transition: all var(--transition);
            padding: 0;
        }
        .slider-dots .dot:hover { background: var(--secondary-color); border-color: var(--secondary-color); }
        .slider-dots .dot.active {
            background: var(--accent-color);
            border-color: var(--accent-color);
            transform: scale(1.3);
            box-shadow: 0 0 0 5px rgba(255, 107, 53, 0.25);
        }

        /* ============================================================
           SECCIONES GENERALES
           ============================================================ */
        .section-padding { padding: 100px 0; }

        .section-title {
            font-size: 2.3rem;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            line-height: 1.2;
        }
        .section-subtitle {
            font-family: 'Montserrat', sans-serif;
            color: var(--accent-color);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 11.5px;
            border-left: 3px solid var(--accent-color);
            padding-left: 14px;
            margin-bottom: 14px;
            display: inline-block;
        }
        .section-lead {
            color: var(--muted-text);
            font-size: 1.02rem;
            max-width: 760px;
            margin: 0 auto;
        }

        /* ============================================================
           TARJETAS DE SERVICIO
           ============================================================ */
        .service-card {
            background: #fff;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
            transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
            height: 100%;
            position: relative;
            padding: 34px 28px 30px;
        }
        .service-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 4px;
            background: linear-gradient(90deg, var(--accent-color), var(--secondary-color));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform var(--transition);
        }
        .service-card:hover::before { transform: scaleX(1); }
        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-lg);
            border-color: var(--secondary-color);
        }
        .service-icon {
            width: 64px; height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(26,43,76,0.06), rgba(142,202,230,0.20));
            color: var(--primary-color);
            font-size: 26px;
            margin-bottom: 22px;
            transition: all var(--transition);
        }
        .service-card:hover .service-icon {
            background: var(--accent-color);
            color: #fff;
            transform: rotate(-6deg) scale(1.06);
            box-shadow: 0 10px 22px rgba(255, 107, 53, 0.35);
        }
        .service-card .num {
            position: absolute;
            top: 22px; right: 26px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            font-size: 2.4rem;
            color: rgba(26, 43, 76, 0.06);
            line-height: 1;
            transition: color var(--transition);
        }
        .service-card:hover .num { color: rgba(255, 107, 53, 0.14); }
        .service-card h4 {
            font-size: 1.13rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--primary-color);
            line-height: 1.35;
        }
        .service-card p {
            font-family: 'Inter', sans-serif;
            color: var(--muted-text);
            font-size: 14.5px;
            line-height: 1.75;
            margin: 0;
        }

        /* ============================================================
           SECCIÓN NOSOTROS
           ============================================================ */
        .about-section {
            background: linear-gradient(180deg, #F8F9FA 0%, #EEF6FB 100%);
        }
        .about-img {
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-color);
        }
        .about-img img {
            width: 100%; height: 100%;
            object-fit: cover;
            min-height: 380px;
            transition: transform 0.7s ease;
        }
        .about-img:hover img { transform: scale(1.04); }

        .mission-vision {
            background: #fff;
            border-left: 4px solid var(--accent-color);
            padding: 22px 26px;
            margin-top: 18px;
            border-radius: 0 12px 12px 0;
            box-shadow: var(--shadow-sm);
            transition: transform var(--transition), box-shadow var(--transition);
        }
        .mission-vision:hover {
            transform: translateX(6px);
            box-shadow: var(--shadow-md);
        }
        .mission-vision h5 {
            color: var(--primary-color);
            font-weight: 700;
            margin-bottom: 8px;
            font-size: 1rem;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }
        .mission-vision h5 i { color: var(--accent-color); }
        .mission-vision p {
            font-family: 'Inter', sans-serif;
            color: var(--muted-text);
            font-size: 14.5px;
            line-height: 1.75;
            margin: 0;
        }

        /* ============================================================
           VALORES
           ============================================================ */
        .values-section { background: #fff; }

        .value-card {
            background: var(--base-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 28px 24px;
            height: 100%;
            text-align: center;
            transition: all var(--transition);
            position: relative;
            overflow: hidden;
        }
        .value-card:hover {
            background: #fff;
            transform: translateY(-8px);
            box-shadow: var(--shadow-md);
            border-color: var(--secondary-color);
        }
        .value-card .v-icon {
            width: 58px; height: 58px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--primary-color);
            color: var(--accent-color);
            font-size: 22px;
            transition: all var(--transition);
        }
        .value-card:hover .v-icon {
            background: var(--accent-color);
            color: #fff;
            transform: scale(1.1);
        }
        .value-card h5 {
            font-size: 0.98rem;
            color: var(--primary-color);
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }
        .value-card p {
            font-size: 13.8px;
            color: var(--muted-text);
            line-height: 1.7;
            margin: 0;
        }

        /* ============================================================
           PROCESO DE TRABAJO
           ============================================================ */
        .process-section {
            background: linear-gradient(180deg, #EEF6FB 0%, #F8F9FA 100%);
        }
        .process-step {
            background: #fff;
            border-radius: var(--radius);
            padding: 30px 26px;
            height: 100%;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            position: relative;
            transition: all var(--transition);
        }
        .process-step:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-color: var(--accent-color);
        }
        .process-step .step-number {
            position: absolute;
            top: -18px; left: 26px;
            width: 46px; height: 46px;
            background: var(--accent-color);
            color: #fff;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            font-size: 1.1rem;
            box-shadow: 0 8px 18px rgba(255, 107, 53, 0.35);
        }
        .process-step h5 {
            font-size: 1rem;
            color: var(--primary-color);
            margin: 16px 0 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .process-step p {
            font-size: 14px;
            color: var(--muted-text);
            line-height: 1.7;
            margin: 0;
        }

        /* ============================================================
           CONTADORES
           ============================================================ */
        .counter-section {
            background:
                linear-gradient(rgba(26, 43, 76, 0.94), rgba(26, 43, 76, 0.94)),
                url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1600') center/cover no-repeat fixed;
            color: #fff;
            text-align: center;
            position: relative;
        }
        .counter-item h2 {
            font-family: 'Montserrat', sans-serif;
            font-size: 3.6rem;
            font-weight: 800;
            color: var(--accent-color);
            margin-bottom: 8px;
            letter-spacing: -1.5px;
            line-height: 1;
        }
        .counter-item p {
            font-family: 'Inter', sans-serif;
            font-size: 0.92rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--secondary-color);
            margin: 0;
        }

        /* ============================================================
           EXPERIENCIA
           ============================================================ */
        .exp-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 30px 28px;
            height: 100%;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition);
            border-top: 4px solid var(--primary-color);
        }
        .exp-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-top-color: var(--accent-color);
        }
        .exp-card .exp-icon {
            width: 52px; height: 52px;
            border-radius: 12px;
            background: rgba(142, 202, 230, 0.22);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
            margin-bottom: 18px;
            transition: all var(--transition);
        }
        .exp-card:hover .exp-icon {
            background: var(--accent-color);
            color: #fff;
        }
        .exp-card h5 {
            font-size: 0.98rem;
            color: var(--primary-color);
            margin-bottom: 10px;
            line-height: 1.4;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .exp-card p {
            font-size: 14px;
            color: var(--muted-text);
            line-height: 1.7;
            margin: 0;
        }

        /* ============================================================
           POR QUÉ GEOARCON
           ============================================================ */
        .why-section {
            background: linear-gradient(180deg, #F8F9FA 0%, #EEF6FB 100%);
        }
        .feature-item {
            display: flex;
            gap: 18px;
            background: #fff;
            padding: 24px 26px;
            border-radius: var(--radius);
            border: 1px solid var(--border-color);
            height: 100%;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition);
        }
        .feature-item:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
            border-color: var(--secondary-color);
        }
        .feature-item .f-icon {
            flex-shrink: 0;
            width: 50px; height: 50px;
            border-radius: 12px;
            background: var(--primary-color);
            color: var(--accent-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: all var(--transition);
        }
        .feature-item:hover .f-icon {
            background: var(--accent-color);
            color: #fff;
            transform: rotate(-6deg);
        }
        .feature-item h5 {
            font-size: 0.96rem;
            color: var(--primary-color);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .feature-item p {
            font-size: 13.8px;
            color: var(--muted-text);
            line-height: 1.65;
            margin: 0;
        }

        /* ============================================================
           CONTACTO
           ============================================================ */
        .contact-section {
            background: linear-gradient(180deg, #F8F9FA 0%, #EEF6FB 100%);
        }
        .contact-info-box {
            background: var(--primary-color);
            color: #fff;
            padding: 42px 34px;
            border-radius: var(--radius);
            height: 100%;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
        }
        .contact-info-box::after {
            content: '';
            position: absolute;
            right: -60px; bottom: -60px;
            width: 200px; height: 200px;
            border-radius: 50%;
            background: rgba(255, 107, 53, 0.10);
        }
        .contact-info-box h4 {
            font-weight: 700;
            margin-bottom: 28px;
            color: #fff;
            font-size: 1.2rem;
            padding-bottom: 14px;
            border-bottom: 2px solid var(--accent-color);
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }
        .contact-info-box .info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 22px;
            position: relative;
            z-index: 1;
        }
        .contact-info-box .info-item i {
            color: var(--accent-color);
            font-size: 17px;
            margin-right: 16px;
            margin-top: 4px;
            width: 22px;
            text-align: center;
            flex-shrink: 0;
        }
        .contact-info-box .info-item p {
            font-family: 'Inter', sans-serif;
            margin: 0;
            opacity: 0.95;
            font-size: 14.3px;
            line-height: 1.7;
            word-break: break-word;
        }
        .contact-info-box .info-item a {
            color: #fff;
            text-decoration: none;
            transition: color var(--transition);
        }
        .contact-info-box .info-item a:hover { color: var(--accent-color); }

